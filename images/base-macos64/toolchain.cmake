set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER x86_64-apple-darwin-clang)
set(CMAKE_CXX_COMPILER x86_64-apple-darwin-clang++)
set(CMAKE_AR x86_64-apple-darwin-ar)
set(CMAKE_RANLIB x86_64-apple-darwin-ranlib)
set(CMAKE_STRIP x86_64-apple-darwin-strip)
set(CMAKE_FIND_ROOT_PATH /opt/ffbuild)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
