set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER arm64-apple-darwin-clang)
set(CMAKE_CXX_COMPILER arm64-apple-darwin-clang++)
set(CMAKE_AR arm64-apple-darwin-ar)
set(CMAKE_RANLIB arm64-apple-darwin-ranlib)
set(CMAKE_STRIP arm64-apple-darwin-strip)
set(CMAKE_FIND_ROOT_PATH /opt/ffbuild)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
